# Port the BFF listens on
PORT=3000
# Comma-separated list of origins allowed by CORS (only needed when the frontend is not behind the same origin)
CORS_ORIGIN=http://localhost:4200
# PokéAPI base URL and request timeout
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_TIMEOUT_MS=8000
# In-memory cache settings
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500
# Serve the OpenAPI docs at /api/docs (set to false to disable)
SWAGGER_ENABLED=true
