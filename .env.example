# Puerto en el que escucha el BFF
PORT=3000
# Orígenes permitidos por CORS, separados por coma (solo se necesita si el frontend no está en el mismo origen)
CORS_ORIGIN=http://localhost:4200
# URL base de PokéAPI y timeout por request
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_TIMEOUT_MS=8000
# Configuración de la caché en memoria
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500
# Publica la documentación OpenAPI en /api/docs (false para desactivarla)
SWAGGER_ENABLED=true
# Logs: nivel mínimo (fatal | error | warn | log | debug | verbose) y formato (pretty | json)
LOG_LEVEL=log
LOG_FORMAT=pretty
